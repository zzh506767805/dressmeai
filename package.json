{
  "name": "dressmeai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "i18n:check": "node scripts/check-locales.js",
    "cf:build": "prisma generate && opennextjs-cloudflare build && node scripts/clean-cloudflare-assets.mjs && node scripts/materialize-cloudflare-pages.mjs && tsx scripts/materialize-cloudflare-feed.ts",
    "cf:preview": "wrangler dev --port 8787",
    "cf:deploy": "wrangler deploy",
    "cf:types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:cloudflare": "tsx --test tests/cloudflare/*.test.ts",
    "postinstall": "prisma generate",
    "test:integration": "tsx --test tests/cloudflare/*.integration.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@azure/storage-blob": "^12.29.1",
    "@headlessui/react": "^1.7.18",
    "@heroicons/react": "^2.1.1",
    "@opennextjs/cloudflare": "^1.20.16",
    "@prisma/adapter-d1": "^6.19.2",
    "@prisma/client": "^6.19.2",
    "autoprefixer": "^10.4.17",
    "axios": "^1.7.9",
    "micro": "^10.0.1",
    "next": "^15.5.29",
    "next-auth": "^4.24.13",
    "next-intl": "^4.5.3",
    "postcss": "^8.4.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.33.5",
    "stripe": "^17.6.0",
    "tailwindcss": "^3.4.1",
    "web-vitals": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.57",
    "@types/react-dom": "^18.2.19",
    "@types/stripe": "^8.0.416",
    "dotenv": "^16.5.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.5.29",
    "prisma": "^6.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "wrangler": "^4.158.0"
  }
}
